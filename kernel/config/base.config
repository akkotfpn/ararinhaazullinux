# SPDX-License-Identifier: GPL-3.0-or-later
# Spix Kernel — fragmento "base" (comum a todas as variantes).
# Aplicado sobre o defconfig da arquitetura com scripts/kconfig/merge_config.sh.
# Cada bloco explica por que a opção existe (ver docs/adr/0001).

# --- Sistema imutável e boot verificado (ADR 0006) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# --- Sistemas de arquivos (Ninho, ADR 0003) ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
CONFIG_CIFS=m
CONFIG_NFS_FS=m
CONFIG_FANOTIFY=y

# --- Isolamento de apps (Bando, Revoada) ---
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_MISC=m

# --- Android via Waydroid (Fase 4) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# --- Observabilidade (Rasante) ---
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# --- Memória ---
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

# --- Rede e VPN ---
CONFIG_NF_TABLES=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m

# --- Interatividade (ADR 0010) ---
CONFIG_PREEMPT_DYNAMIC=y
