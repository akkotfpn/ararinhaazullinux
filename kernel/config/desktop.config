# SPDX-License-Identifier: GPL-3.0-or-later
# Spix Kernel, fragmento "desktop" (Fase 2): o que a Plumagem precisa para
# ler teclado/mouse e desenhar na tela de máquinas reais.

# Entrada: a libinput lê os dispositivos por /dev/input/event*
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=m
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y

# Vídeo de placas reais (módulos carregados conforme o hardware)
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_QXL=m

# Firmware lido de /usr/lib/firmware (placas AMD, Intel e NVIDIA precisam)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Memória compartilhada entre compositor e apps (dmabuf, memfd)
CONFIG_DMABUF_HEAPS=y
CONFIG_UDMABUF=y
CONFIG_SYNC_FILE=y

# Som: placas onboard (HDA) e USB (headsets, interfaces).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m

# Wi-Fi (o iwd conecta; cfg80211/mac80211 e os drivers mais comuns como
# módulos). O mac80211_hwsim cria rádios de mentira para testar em VM.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_MAC80211_HWSIM=m
# Intel
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
# Realtek
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTL8XXXU=m
# Qualcomm Atheros
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# MediaTek
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
# Broadcom
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y

# Criptografia que o iwd usa pelo kernel (chaves, AF_ALG, certificados).
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_DH=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
