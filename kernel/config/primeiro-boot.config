# SPDX-License-Identifier: GPL-3.0-or-later
# Spix Kernel — fragmento "primeiro-boot" (Fase 1).
# O kernel inicia sozinho como aplicativo UEFI (EFI stub), sem bootloader e
# sem initramfs: tudo que é preciso para achar o disco e mostrar a tela vem
# embutido (=y). O systemd-boot e o initramfs entram com a Muda (ADR 0006).

# Linha de comando embutida: a raiz é achada pelo nome da partição GPT.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="root=PARTLABEL=ararinha-raiz rw quiet loglevel=3 console=tty0 console=ttyS0,115200"

# Discos e partições (Proxmox usa virtio-scsi; QEMU às vezes virtio-blk)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Rede cabeada da VM
CONFIG_VIRTIO_NET=y
CONFIG_E1000E=y

# Tela e console (UEFI + virtio-gpu + serial do Proxmox)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Exigências do systemd
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
