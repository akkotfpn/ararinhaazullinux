# Spix Kernel — fragmento "vm": convidado em Proxmox/QEMU, VMware, VirtualBox e Hyper-V.

CONFIG_HYPERVISOR_GUEST=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=m
CONFIG_SCSI_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m

# VMware
CONFIG_VMWARE_PVSCSI=m
CONFIG_VMXNET3=m
CONFIG_DRM_VMWGFX=m

# Hyper-V
CONFIG_HYPERV=m
CONFIG_HYPERV_STORAGE=m
CONFIG_HYPERV_NET=m
